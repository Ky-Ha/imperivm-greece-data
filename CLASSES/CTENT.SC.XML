<class id="CTent" cpp_class="CVXTownHall" parent="Building" entity="Buildings/Numidian_tent/Numidian_tent.ent.xml">

	<properties maxhealth="15000" sight="900"/>
	<properties display_name="Numidian Tent"/>
	<properties radius="190" selection_radius="195"/>
	<properties edittree_pos="Structures/Interactive/Numidian Tent"/>
	<properties icon="gameres/icons/CTent.bmp"/>
	<properties interface="thumb,building,holder"/>
	<properties help="/contents/buildings/TTent"/>
	<properties description="Keeps up to 40 Numidian warrios that attack any enemy in sight"/>

	<behavior script="data/subai/ctent_behavior.vs"/>
	<behavior script="data/subai/ttent_feeding_behavior.vs"/>
	
	<method sig="createfoodmulesmall" vs="data/subai/create_food_mule_small.vs"/>
	<method sig="createfoodmulebig"   vs="data/subai/create_food_mule_big.vs"/>
	<method sig="creategoldmulebig"   vs="data/subai/create_gold_mule_big.vs"/>
	<method sig="teutonProduction"    vs="data/subai/ctent_numidian_production.vs"/>
	
	
	<properties
		is_central_building="1"
		is_single_building="1"
		can_be_captured="1"
		can_be_attacked="0"
		produces_gold="0"
		produces_food="0"
		settlement_food="0"
		settlement_gold="0"
		settlement_maxfood="100000000"
		settlement_maxgold="0"
		population="0"
		efficiency="1"
		max_population="0"
		max_units="0"
		settlement_icon_name=""
		minimap_icon_type="color"
	/>

	<value0
		icon="gameres/infobar/common/food ico.bmp"
		script="return .AsBuilding.settlement.food;"
		help=""
		rollover="Each new numidian produced costs 400 food"/>
	/>

	<defaultcmd target="">
		<cmd name="unitsout"/>
	</defaultcmd>
</class>
