<?xml version="1.0"?>

<map-template name="Random Real World" >

	<bitmap file="RandomMap/Real World/"/>

	<transform allow-rotate="0" allow-mirror="0" />
    <distortion amp="0" first-oct="1" number-octs="1" persist="0"/>

	<color-code red="0"   green="0"   blue="0"   meaning="sea"/>
	<color-code red="255" green="255" blue="255" meaning="land"/>
	<color-code red="255" green="0"   blue="0"   meaning="player-stronghold"/>
	<color-code red="255"   green="0" blue="255"   meaning="mountain"/>

	<limit map-size="small" max-players="0"/>
	<limit map-size="medium" max-players="4"/>
	<limit map-size="large" max-players="8"/>
</map-template>
